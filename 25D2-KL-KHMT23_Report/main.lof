\addvspace {10\p@ }
\contentsline {figure}{\numberline {3.1}{\ignorespaces Minh họa bài toán phân đoạn ảnh y sinh: mô hình $f_\theta $ biến ảnh gốc thành một mặt nạ nhị phân ở mức điểm ảnh, minh họa trên hai tập dữ liệu PH2 (tổn thương da) và GlaS 2015 (tuyến trong mô học).}}{18}{figure.3.1}%
\contentsline {figure}{\numberline {3.2}{\ignorespaces Kiến trúc U-Net kinh điển: nhánh mã hóa (trái) giảm dần độ phân giải và tăng số kênh, nhánh giải mã (phải) khôi phục độ phân giải, cùng các kết nối tắt ngang (skip connections) bảo toàn chi tiết không gian.}}{24}{figure.3.2}%
\contentsline {figure}{\numberline {3.3}{\ignorespaces Tích chập giãn nở với hệ số $r=1,2,3$: cùng một bộ lọc $3\times 3$ ($9$ trọng số) nhưng trường nhìn hiệu dụng mở rộng thành $3\times 3$, $5\times 5$, $7\times 7$ mà không tăng số tham số.}}{27}{figure.3.3}%
\contentsline {figure}{\numberline {3.4}{\ignorespaces Mặt cầu Bloch: trạng thái một qubit $|\psi \rangle =\cos \tfrac {\theta }{2}|0\rangle +e^{i\varphi }\sin \tfrac {\theta }{2}|1\rangle $ ứng với một điểm trên mặt cầu đơn vị, xác định bởi hai góc $\theta $ và $\varphi $.}}{30}{figure.3.4}%
\contentsline {figure}{\numberline {3.5}{\ignorespaces Ví dụ một mạch lượng tử tham số hóa: mỗi dây ngang là một qubit, đi qua cổng Hadamard ($H$) tạo chồng chất, các cổng quay có tham số ($R$, $R_x$, $R_y$) và các cổng vướng víu CNOT, kết thúc bằng phép đo.}}{34}{figure.3.5}%
\contentsline {figure}{\numberline {3.6}{\ignorespaces Khung Mixture of Experts: một mạng định tuyến (router) sinh trọng số softmax $w_i(x)$ phân bổ cho các nhánh xử lý $E_i$ chạy song song, đầu ra là tổ hợp có trọng số $y=\DOTSB \sum@ \slimits@ _i w_i(x)E_i(x)$.}}{43}{figure.3.6}%
\contentsline {figure}{\numberline {3.7}{\ignorespaces Cơ chế quét chọn lọc của Mamba: trạng thái ẩn cập nhật theo công thức hồi quy $h_t=a\odot h_{t-1}+b_t\odot x_t$ với các cổng $b_t, c_t$ phụ thuộc đầu vào, cho phép mô hình hóa phụ thuộc tầm xa với chi phí tuyến tính.}}{49}{figure.3.7}%
\contentsline {figure}{\numberline {3.8}{\ignorespaces Quy trình Seg-Grad-CAM: gradient của điểm số vùng quan tâm $S$ lan truyền ngược về tầng tích chập đích để tính trọng số kênh $\alpha _k$, tổ hợp và lọc dương thành bản đồ nhiệt phủ lên ảnh gốc (đỏ = đáp ứng cao).}}{53}{figure.3.8}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {4.1}{\ignorespaces Tổng quan kiến trúc HQMoSS-Net: bộ khung U-Net với khối RDMS ở encoder/decoder, và khối QuantumMoE cùng LSS được nhúng tại vùng nút thắt cổ chai.}}{58}{figure.4.1}%
\contentsline {figure}{\numberline {4.2}{\ignorespaces Khối RDMS (Residual Dilated Multi-Scale): một tích chập $3\times 3$ tạo nhánh tắt $s$, ba nhánh tích chập tách kênh giãn nở (dilation $1/2/3$) chạy song song, ghép kênh rồi tinh chỉnh và cộng phần dư.}}{62}{figure.4.2}%
\contentsline {figure}{\numberline {4.3}{\ignorespaces Luồng xử lý một nhánh xử lý lượng tử \texttt {QuantumExpert}: trích patch trượt, chuẩn hóa, mã hóa biên độ và chạy PQC (phần lượng tử khả vi), rồi chuẩn hóa và tái tổ hợp bằng overlap-add.}}{63}{figure.4.3}%
\contentsline {figure}{\numberline {4.4}{\ignorespaces Mạch lượng tử tham số hóa \texttt {PQCExpert}: tầng Hadamard tạo chồng chất, khối lặp $L$ lần gồm cổng quay $\text {Rot}$ trên mỗi qubit và chuỗi CNOT khép vòng, cuối cùng là các cổng $R_x/R_y$ theo $i \bmod 3$ và phép đo phân bố xác suất.}}{65}{figure.4.4}%
\contentsline {figure}{\numberline {4.5}{\ignorespaces Tái tổ hợp \emph {overlap-add} với \texttt {stride}$=1$: các patch chồng lấn được xử lý qua PQC rồi cộng dồn và chia cho số lần phủ, cho ra bản đồ đặc trưng liền mạch.}}{66}{figure.4.5}%
\contentsline {figure}{\numberline {4.6}{\ignorespaces Khối QuantumMoE: ba nhánh xử lý lượng tử đa tỷ lệ, mạng định tuyến $\mathrm {Softmax}(\mathrm {Conv}_{1\times 1})$ trên bản ghép $[F, E_1, E_2, E_3]$ sinh trọng số theo từng điểm ảnh, và kết nối phần dư $\mathrm {QuantumMoE}(F)=F+\DOTSB \sum@ \slimits@ _i w_i\odot E_i$.}}{68}{figure.4.6}%
\contentsline {figure}{\numberline {4.7}{\ignorespaces Khối LSS (Lightweight Selective Scan): chuẩn hóa và chiếu $1\times 1$, tách nhánh đặc trưng/cổng, quét chọn lọc tuyến tính $h_t=a\odot h_{t-1}+b_t\odot x_t$, cổng sigmoid, và chiếu ra khởi tạo bằng không kèm kết nối phần dư.}}{69}{figure.4.7}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {5.1}{\ignorespaces Sơ đồ kiểm định chéo $5$-fold: dữ liệu chia thành năm phần, mỗi lần một phần dùng làm tập kiểm định (cam) và bốn phần còn lại dùng để huấn luyện (xanh).}}{83}{figure.5.1}%
\contentsline {figure}{\numberline {5.2}{\ignorespaces Quy trình thực nghiệm: tiền xử lý dữ liệu PH2/GlaS, chia $5$-fold, huấn luyện HQMoSS-Net (BCE, Adam, 60 epoch), dự đoán trên tập kiểm định rồi tính tám độ đo và tổng hợp báo cáo trung bình $\pm $ độ lệch chuẩn.}}{84}{figure.5.2}%
\contentsline {figure}{\numberline {5.3}{\ignorespaces Biểu đồ cột so sánh Soft IoU trung bình của bảy mô hình trên PH2 (trái) và GlaS 2015 (phải): baseline cổ điển (xanh), mốc lượng tử QuNet/QuFeX (cam) và HQMoSS-Net đề xuất (tím). HQMoSS-Net dẫn đầu trên cả hai tập dữ liệu.}}{87}{figure.5.3}%
\contentsline {figure}{\numberline {5.4}{\ignorespaces Hiệu quả tham số: số tham số (trục hoành, thang log) so với Soft IoU trung bình (trục tung) của từng mô hình trên PH2 (trái) và GlaS 2015 (phải). HQMoSS-Net (ngôi sao tím) đạt IoU cao nhất trong khi số tham số thuộc nhóm thấp nhất.}}{88}{figure.5.4}%
\contentsline {figure}{\numberline {5.5}{\ignorespaces Biểu đồ cột Soft IoU của tám cấu hình thực nghiệm trên PH2 kèm mốc lượng tử QuNet (QuFeX, màu cam), minh họa mức đóng góp cộng dồn của các thành phần cổ điển (LSS, RDMS) và lượng tử (QuMoE), đạt đỉnh ở HQMoSS-Net đầy đủ.}}{90}{figure.5.5}%
\contentsline {figure}{\numberline {5.6}{\ignorespaces Soft IoU theo số lớp mạch $L=1,\dots ,5$ của mỗi nhánh xử lý trên PH2; hiệu năng ổn định và đạt tốt nhất tại $L=5$ (màu tím) -- cấu hình được chọn làm mặc định.}}{91}{figure.5.6}%
\contentsline {figure}{\numberline {5.7}{\ignorespaces So sánh tám chỉ số (thang $[0,1]$, thanh lỗi = độ lệch chuẩn $5$-fold) giữa QuantumMoE$(5,5,5)$ (tím, $86{,}996$ tham số) và Classical MoE cùng kiến trúc (xanh, $1{,}693{,}908$ tham số) trên PH2.}}{94}{figure.5.7}%
\contentsline {figure}{\numberline {5.8}{\ignorespaces Tỷ trọng trung bình mỗi nhánh xử lý (thanh lỗi = độ lệch chuẩn giữa các ảnh) trên PH2 và GlaS 2015, fold 1. Đường nét đứt là mức cân bằng tuyệt đối ($1/3$).}}{98}{figure.5.8}%
\contentsline {figure}{\numberline {5.9}{\ignorespaces So sánh tám chỉ số diễn giải cùng thang $[0,1]$ giữa U-Net (xanh) và HQMoSS-Net (tím) trên PH2 (trái) và GlaS 2015 (phải). IoU-O/Dice-O: ngưỡng Otsu; IoU-M/Dice-M: ngưỡng matched; B-IoU: Boundary IoU; EPG: Energy Pointing Game; Del-AUC/Ins-AUC: Deletion/Insertion AUC.}}{104}{figure.5.9}%
\contentsline {figure}{\numberline {5.10}{\ignorespaces Hausdorff Distance 95\% (HD95, đơn vị pixel, thấp hơn tốt hơn) của U-Net và HQMoSS-Net trên PH2 và GlaS 2015. HQMoSS-Net có HD95 thấp hơn trên cả hai bộ dữ liệu.}}{105}{figure.5.10}%
\contentsline {figure}{\numberline {5.11}{\ignorespaces So sánh Seg-Grad-CAM trên PH2. Mỗi hàng, từ trái sang phải: ảnh gốc, mặt nạ thực, bản đồ nhiệt của U-Net và của HQMoSS-Net (kèm IoU matched). Bản đồ nhiệt của HQMoSS-Net bám sát vùng tổn thương hơn hẳn U-Net.}}{106}{figure.5.11}%
\contentsline {figure}{\numberline {5.12}{\ignorespaces So sánh Seg-Grad-CAM trên GlaS 2015 (mô học nhiều tuyến). Mỗi hàng, từ trái sang phải: ảnh gốc, mặt nạ thực, bản đồ nhiệt của U-Net và của HQMoSS-Net (kèm IoU matched). HQMoSS-Net tách và bám các tuyến rời rạc tốt hơn.}}{107}{figure.5.12}%
